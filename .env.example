# MS Woodworks — ملف إعدادات البيئة (.env)
# لا تشارك هذا الملف ولا ترفعه إلى Git. يحتوي على أسرار الجلسة وقاعدة البيانات.

NODE_ENV=development
PORT=3000

# قاعدة البيانات
POSTGRES_DB=mswood
POSTGRES_USER=mswood
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://mswood:change-me@localhost:5432/mswood
PGSSL=false

# بيانات administrator generales (الطلبات، التعليقات، العملاء، المصروفات)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SESSION_SECRET=

# بيانات المالك (المالك فقط) — تُستخدم لقفل قسم "العاملين" وصلاحيات الموظفين الحساسة
OWNER_USERNAME=owner
OWNER_PASSWORD=
