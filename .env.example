# MS Woodworks — ملف إعدادات البيئة (.env)
# لا تشارك هذا الملف ولا ترفعه إلى Git. يحتوي على أسرار الجلسة وقاعدة البيانات.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# قاعدة البيانات
POSTGRES_DB=mswood
POSTGRES_USER=mswood
POSTGRES_PASSWORD=
# املأ DATABASE_URL محليًا؛ في Docker Compose يجب أن يركّبه الإعداد من خدمة PostgreSQL.
DATABASE_URL=
# على Vercel، اضبط PGSSL=true إذا كان مزود قاعدة البيانات يتطلب TLS (مثل Neon/Supabase)
PGSSL=false

# بيانات الإدارة — لا توجد بيانات دخول افتراضية
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=

# بيانات المالك المطلوبة لمسارات العاملين والرواتب
OWNER_USERNAME=
OWNER_PASSWORD=
